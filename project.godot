; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sigaw sa Negros"
config/description="Top-down 3D zombie survival shooter set in Negros Island, Philippines."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Bootstrap="*res://scripts/autoload/bootstrap.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
GameState="*res://scripts/autoload/game_state.gd"
TimeOfDay="*res://scripts/autoload/time_of_day.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="PlayerBody"
3d_physics/layer_3="EnemyBody"
3d_physics/layer_4="PlayerHurtbox"
3d_physics/layer_5="EnemyHurtbox"
3d_physics/layer_6="Interactable"

[rendering]

environment/defaults/default_clear_color=Color(0.35, 0.4, 0.5, 1)
